ARG DX_COMPILER_BASE_IMAGE=dx-compiler:2.4.2-dxcom-2.4.1-ubuntu-22.04
FROM ${DX_COMPILER_BASE_IMAGE}

ARG EXPECTED_DX_COM_VERSION=2.4.1

ENV VIRTUAL_ENV=/venv-dxnn \
    PATH=/venv-dxnn/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER root

RUN dxcom --version 2>&1 \
    | grep -F "DX-COM (DEEPX Compiler) ${EXPECTED_DX_COM_VERSION}"

COPY requirements/dxcompile.txt /tmp/requirements-dxcompile.txt
RUN /venv-dxnn/bin/python -m pip install --no-cache-dir \
        -r /tmp/requirements-dxcompile.txt

USER deepx
WORKDIR /deepx/workspace

CMD ["bash"]
